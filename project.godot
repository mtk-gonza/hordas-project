; Engine configuration file.
; Proyecto cooperativo de supervivencia top-down.

config_version=5

[application]
config/name="Hordas Cooperativo"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
NetworkManager="*res://autoload/network_manager.gd"
MetaProgression="*res://autoload/meta_progression.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]
2d/default_gravity=0.0
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.075, 1)
